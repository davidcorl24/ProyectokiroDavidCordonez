rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return request.auth.token.get('rol', request.auth.token.get('role', 'voluntario'));
    }

    function isCoordinator() {
      return signedIn() && userRole() in ['coordinador', 'administrador'];
    }

    function isAdministrator() {
      return signedIn() && userRole() == 'administrador';
    }

    function hasActivePeriod(periodId) {
      let configPath = /databases/$(database)/documents/configuracion/global;
      return periodId is string
        && periodId.size() > 0
        && exists(configPath)
        && get(configPath).data.get('periodoActivoId', '') == periodId;
    }

    function familyAlreadyDeliveredThisPeriod(periodId) {
      return resource.data.get('periodoDistribucionId', '') == periodId
        && (resource.data.get('entregasEnPeriodo', 0) > 0
          || resource.data.get('entregado', false) == true);
    }

    match /voluntarios/{voluntarioId} {
      allow read: if signedIn();
      allow create, update: if isCoordinator();
      allow delete: if isAdministrator();
    }

    match /donaciones/{donacionId} {
      allow read, create: if signedIn();
      allow update: if isCoordinator();
      allow delete: if isAdministrator();
    }

    match /almacen/{articuloId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad >= 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantidad', 'estado'])
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad >= 0
        && request.resource.data.cantidad < resource.data.cantidad
        && (request.resource.data.cantidad == 0
          ? request.resource.data.estado == 'sinstock'
          : request.resource.data.estado == resource.data.estado);
      allow delete: if isCoordinator();
    }

    match /familiasBeneficiarias/{familiaId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow delete: if isCoordinator();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['entregado', 'fechaEntrega', 'segundaEntrega', 'periodoDistribucionId', 'entregasEnPeriodo'])
        && request.resource.data.get('entregado', false) == true
        && request.resource.data.get('fechaEntrega', '') is string
        && request.resource.data.get('segundaEntrega', false) is bool
        && request.resource.data.get('entregasEnPeriodo', 0) is int
        && request.resource.data.get('entregasEnPeriodo', 0) > 0
        && hasActivePeriod(request.resource.data.get('periodoDistribucionId', ''))
        && (!familyAlreadyDeliveredThisPeriod(request.resource.data.get('periodoDistribucionId', ''))
          || isCoordinator());
    }

    match /registrosEntrega/{registroId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && hasActivePeriod(request.resource.data.get('periodoDistribucionId', ''))
        && request.resource.data.get('familiaId', '') is string
        && request.resource.data.get('familiaNombre', '') is string
        && request.resource.data.get('fechaEntrega', '') is string
        && request.resource.data.get('articulosEntregados', []) is list
        && request.resource.data.get('articulosEntregados', []).size() > 0
        && request.resource.data.get('confirmadaPorCoordinador', false) is bool
        && (!request.resource.data.get('confirmadaPorCoordinador', false) || isCoordinator());
      allow update: if isCoordinator();
      allow delete: if isAdministrator();
    }

    match /movimientosAlmacen/{movimientoId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.get('cantidad', 0) is int
        && request.resource.data.get('cantidad', 0) > 0
        && request.resource.data.get('motivo', '') in [
          'donacion_recibida',
          'entrega',
          'descarte_caducidad'
        ];
      allow update, delete: if false;
    }

    match /herramientasDigitales/{herramientaId} {
      allow read: if signedIn();
      allow create, update, delete: if isCoordinator();
    }

    match /umbralesEscasez/{tipoAlimentoId} {
      allow read: if signedIn();
      allow write: if isCoordinator();
    }

    match /contadores/{contadorId} {
      allow read, write: if isAdministrator();
    }

    match /configuracion/{configuracionId} {
      allow read: if signedIn();
      allow write: if isAdministrator();
    }

    match /recibos/{reciboId} {
      allow read, create, update: if isAdministrator();
      allow delete: if false;
    }

    match /notificaciones/{notificacionId} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
